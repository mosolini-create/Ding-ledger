
{
  "name": "ding-ledger",
  "version": "1.0.0",
  "description": "DINGLEDGER Accounting Software",
  "main": "main.js",
  "author": "DINGLEDGER",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^7.0.0"
  },
  "build": {
    "appId": "com.dingledger.desktop",
    "productName": "DINGLEDGER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "icon.png",
      "logo-splash.jpg",
      "manifest.webmanifest",
      "sw.js",
      "main.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
